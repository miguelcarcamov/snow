FROM ghcr.io/miguelcarcamov/snow:base

# Install the snow wheel from dist/: in CI this is the wheel built and tested from the same commit
# (see .github/workflows/build_latest_container.yaml). Locally, run `python3 -m build --wheel`
# before `docker build -f Dockerfile.prod .`.
COPY dist/*.whl /tmp/dist/
RUN python3 -m pip install --no-cache-dir /tmp/dist/*.whl && \
    rm -rf /tmp/dist /root/.cache/pip && \
    mkdir -p ~/.casa/data && \
    echo "Hello from snow production image"
LABEL org.opencontainers.image.source="https://github.com/miguelcarcamov/snow"
LABEL org.opencontainers.image.description="Container image for SNOW"
LABEL org.opencontainers.image.licenses=GPL3
